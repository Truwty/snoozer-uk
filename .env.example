# Use the exact browser origin. Set at build time as well as runtime.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only. Required for validated avatar processing and serving.
SUPABASE_SERVICE_ROLE_KEY=

# Optional. Stripe sandbox snapshot destination signing secret. Leave blank to disable intake.
STRIPE_SANDBOX_WEBHOOK_SECRET=
# Optional. Restricted Stripe sandbox API key for Checkout. Live keys are rejected.
STRIPE_SANDBOX_API_KEY=
# Enable only on an isolated Supabase project used for Stripe test purchases.
STRIPE_SANDBOX_GRANTS_ENABLED=false
# Optional. Stripe Billing Portal configuration ID from the same sandbox.
STRIPE_SANDBOX_PORTAL_CONFIGURATION=
# Optional. Verification token from the platform Ko-fi webhook dashboard.
KOFI_WEBHOOK_TOKEN=
# Optional. Separate randomly generated server token for sandbox event recovery.
STRIPE_SANDBOX_RECOVERY_TOKEN=
# Optional. HTTPS Ko-fi profile for the platform support link on the home page.
KOFI_PLATFORM_PROFILE_URL=
# Optional. Stable 32-byte hex key for deriving sandbox paid gift codes.
STRIPE_SANDBOX_GIFT_KEY=

# Optional creator-domain verification: read-only scoped Render credential, never public.
# Association/removal is operator-managed within included domain capacity; no automatic purchases.
RENDER_CUSTOM_DOMAINS_API_KEY=
# Render supplies RENDER_SERVICE_ID automatically; set explicitly only outside Render.
# Use the service's onrender.com host even after the primary website moves to Snoozer.uk.
RENDER_SERVICE_HOSTNAME=

# RETIRED: third-party creator commerce and Connect seller onboarding must stay disabled.
# Leave all creator-specific flags false. Platform Premium billing above remains independent.
SNOOZER_CREATOR_SANDBOX_ENABLED=false
# Exact platform account in the same sandbox; provider self-read must match it.
STRIPE_CREATOR_SANDBOX_PLATFORM_ID=
# Prefer a separate restricted test key. Falls back to the existing sandbox key if blank.
# Needs platform self-read, Accounts v2 create/read and Account Links v2 create.
# Checkout additionally needs connected-account Checkout read/write plus PaymentIntent,
# Charge, Dispute and early-fraud-warning reads; review docs/creator-recovery.md before enabling.
STRIPE_CREATOR_SANDBOX_API_KEY=

# Separate creator Checkout gate; onboarding alone never permits purchases.
# Keep off until connected-account webhook, order recovery and buyer delivery are configured/tested.
SNOOZER_CREATOR_CHECKOUT_ENABLED=false
# Signing secret for a separate snapshot destination receiving events from connected accounts.
# Never reuse the platform subscription webhook secret.
STRIPE_CREATOR_SANDBOX_WEBHOOK_SECRET=
# Optional dedicated operator bearer token (32+ random characters) for bounded persisted-receipt retries.
# Never reuse premium billing's operator token. Keep the matching GitHub workflow disabled until verified.
STRIPE_CREATOR_SANDBOX_RECOVERY_TOKEN=

# Snoozer-owned Premium LIVE billing (separate from retired creator commerce).
# NEVER use sk_test_ here. Place secrets only in Render/server env, never NEXT_PUBLIC_.
# Stripe LIVE account ID, restricted LIVE API key, separate LIVE webhook secret:
STRIPE_PREMIUM_LIVE_ACCOUNT_ID=
STRIPE_PREMIUM_LIVE_API_KEY=
STRIPE_PREMIUM_LIVE_WEBHOOK_SECRET=
STRIPE_PREMIUM_LIVE_PORTAL_CONFIGURATION=
# Every flag must remain false until genuine signed provider acceptance,
# legally verified prices/tax jurisdiction, email delivery and operator approval.
SNOOZER_PREMIUM_LIVE_ENABLED=false
SNOOZER_PREMIUM_TAX_CONFIRMED=false
SNOOZER_PREMIUM_LEGAL_CONFIRMED=false
# Optional 32+ character server-only secret for safe missed-event replay/sweep.
STRIPE_PREMIUM_LIVE_RECOVERY_TOKEN=
